import fs from "node:fs";
import path from "node:path";
import cookieParser from "cookie-parser";
import cors from "cors";
import express, { type Express } from "express";
import rateLimit from "express-rate-limit";
import helmet from "helmet";
import pinoHttp from "pino-http";
import type { Health } from "@scaffold/shared";
import router from "./routes";
import { logger } from "./lib/logger";

// Fleet previews serve the app under BASE_PATH (e.g. /direct/<agent>:<port>) and
// forward requests with that prefix intact; root-absolute requests from the page
// arrive unprefixed. Accept both by stripping the prefix when present.
const basePath = (process.env.BASE_PATH ?? "").replace(/\/+$/, "");

export function createApp(): Express {
  const app = express();

  if (basePath) {
    app.use((req, _res, next) => {
      if (req.url === basePath || req.url.startsWith(`${basePath}/`) || req.url.startsWith(`${basePath}?`)) {
        req.url = req.url.slice(basePath.length) || "/";
        if (req.url.startsWith("?")) req.url = `/${req.url}`;
      }
      next();
    });
  }

  app.use(
    helmet({
      // CSP off: the SPA loads Google Fonts and the guided demos use inline media.
      contentSecurityPolicy: false,
      // Keep same-origin Referer: the fleet ingress routes an embedded app's
      // root-absolute requests back to it by Referer (helmet defaults to no-referrer).
      referrerPolicy: { policy: "strict-origin-when-cross-origin" },
    }),
  );
  app.use(cors());
  app.use(
    pinoHttp({
      logger,
      serializers: {
        req(req) {
          return { id: req.id, method: req.method, url: req.url?.split("?")[0] };
        },
        res(res) {
          return { statusCode: res.statusCode };
        },
      },
    }),
  );
  app.use(express.json());
  app.use(express.urlencoded({ extended: true }));
  app.use(cookieParser(process.env.SESSION_SECRET));
  app.use(
    "/api",
    rateLimit({
      windowMs: 15 * 60 * 1000,
      // Guided demo directors poll heavily; keep the ceiling generous.
      limit: Number(process.env.RATE_LIMIT_MAX ?? 5000),
      standardHeaders: "draft-7",
      legacyHeaders: false,
      skip: (req) => req.path === "/health" || req.path === "/healthz",
    }),
  );

  app.get("/api/health", (_req, res) => {
    res.json({ status: "ok" } satisfies Health);
  });
  app.use("/api", router);

  // In production, serve the built web client from the same process.
  const clientDist = path.resolve(process.cwd(), "../web/dist");
  if (fs.existsSync(clientDist)) {
    app.use(express.static(clientDist));
    app.use((_req, res) => {
      res.sendFile(path.join(clientDist, "index.html"));
    });
  } else {
    app.get("/", (_req, res) => {
      res.json({ service: "CLMS API", status: "ok" });
    });
  }

  return app;
}
